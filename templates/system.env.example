# ============================================================
# TG Bot System Configuration
# ============================================================

# Mihomo API
MIHOMO_API="http://127.0.0.1:9999"

# Telegram 代理（留空=直连；如 http://127.0.0.1:7890 则优先代理，失败自动直连）
TG_PROXY=""

# 远程版本地址
TG_VERSION_URL=""

# 更新软件包地址
TG_PACKAGE_URL=""

# 手动补充服务面板（非 Docker/未自动识别）：名称=端口，多个用空格分隔
PANEL_SERVICES=""

# 国内推送兜底（Telegram 不可达时自动切换）：企业微信群机器人 webhook / Server酱 SendKey，留空=不启用
WECOM_WEBHOOK=""
SCT_KEY=""
